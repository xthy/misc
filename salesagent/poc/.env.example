# B2B Sales Agent PoC — Environment Variables
# cp .env.example .env 후 실제 값으로 교체하세요.

# ─── n8n ───
N8N_USER=admin
N8N_PASSWORD=salesagent

# ─── PostgreSQL (pgvector) ───
PG_USER=salesagent
PG_PASSWORD=salesagent_dev

# ─── OpenAI (GPT-4o API) ───
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# ─── CRM (택 1) ───
# Salesforce
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# HubSpot
HUBSPOT_API_KEY=pat-YOUR_KEY_HERE

# ─── Monitoring (Helicone — optional) ───
HELICONE_API_KEY=sk-helicone-YOUR_KEY_HERE

# ─── Slack (알림 — optional) ───
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
